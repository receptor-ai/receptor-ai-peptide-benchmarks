cff-version: 1.2.0
message: "If you use this benchmark, please cite it as below."
title: "Peptide passive-permeability benchmark on CycPeptMPDB"
abstract: >-
  Curated PAMPA permeability measurements for cyclic peptides, taken from
  CycPeptMPDB. It holds 7027 measured log P_app values over 42 source
  papers, the structure of every peptide as SMILES, HELM and a monomer
  sequence, and the DOI of every one of those papers.
type: dataset
authors:
  - name: "Receptor.AI, Inc."
    website: "https://receptor.ai"
repository-code: "https://github.com/receptor-ai/receptor-ai-peptide-benchmarks"
url: "https://github.com/receptor-ai/receptor-ai-peptide-benchmarks"
license: CC-BY-4.0
version: "1.0.0"
date-released: "2026-09-21"
keywords:
  - peptides
  - cyclic peptides
  - passive permeability
  - PAMPA
references:
  - type: article
    title: "CycPeptMPDB: A Comprehensive Database of Membrane Permeability of Cyclic Peptides"
    authors:
      - family-names: "Li"
        given-names: "Jianan"
      - family-names: "Yanagisawa"
        given-names: "Keisuke"
      - family-names: "Sugita"
        given-names: "Masatake"
      - family-names: "Fujie"
        given-names: "Takuya"
      - family-names: "Ohue"
        given-names: "Masahito"
      - family-names: "Akiyama"
        given-names: "Yutaka"
    journal: "J. Chem. Inf. Model."
    year: 2023
    volume: "63"
    issue: "7"
    start: "2240"
    end: "2250"
    doi: "10.1021/acs.jcim.2c01573"
    notes: "The upstream database. Every measurement in this release comes from it. The DOI of each original source paper is in inputs/pampa_sources.csv."
