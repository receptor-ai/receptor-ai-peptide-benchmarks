url: "https://github.com/receptor-ai/receptor-ai-peptide-benchmarks"
license: CC-BY-4.0
version: "2.0.0"
date-released: "2026-09-11"
keywords:
  - peptides
  - binding affinity
  - scoring function
  - benchmark
